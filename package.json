{
  "name": "sb-rental",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --test tests/*.test.ts",
    "check": "npm run test && npm run lint && npm run build",
    "deploy": "npm run build && wrangler deploy",
    "supabase:start": "node scripts/supabase-start.mjs",
    "supabase:stop": "supabase stop",
    "supabase:env": "node scripts/supabase-env.mjs",
    "supabase:migrate": "supabase migration up --local",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@supabase/supabase-js": "^2.116.0",
    "lucide-react": "^1.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.6",
    "@cloudflare/workers-types": "^5.20260908.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vercel/routing-utils": "^6.6.0",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "supabase": "2.117.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "wrangler": "^4.130.0"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "overrides": {
    "@vercel/routing-utils": {
      "path-to-regexp": "6.3.0"
    },
    "sharp": "^0.35.4"
  }
}

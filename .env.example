# Générer .env.local avec : npm run supabase:env
# URL et clé PUBLIQUE de Supabase local uniquement (valeurs fournies par le CLI).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# Réservé aux futurs visuels R2.
VITE_R2_PUBLIC_URL=

# Ne jamais mettre de clé service_role, sb_secret ou autre secret dans VITE_*.
